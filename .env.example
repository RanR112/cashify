# Salin ke .env lalu ganti semua nilai bertanda "ganti-" dengan nilai asli.
# Nilai di bawah hanya contoh bentuk; semuanya palsu.
# Jangan kosongkan variabel: "NODE_ENV=" menghasilkan string kosong dan membuat
# validasi Zod gagal, bukan memakai nilai bawaan. Hapus barisnya bila ingin bawaan.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Supabase Postgres: pooler (6543) untuk runtime, langsung (5432) untuk migrasi.
# Dashboard Supabase -> Project Settings -> Database -> Connection string.
# Karakter khusus di password harus di-URL-encode (misal @ menjadi %40).
DATABASE_URL=postgresql://postgres.ganti-project-ref:ganti-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:ganti-password@db.ganti-project-ref.supabase.co:5432/postgres

# Redis dari docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Dashboard Supabase -> Project Settings -> API (dan JWT Settings untuk secret)
SUPABASE_URL=https://ganti-project-ref.supabase.co
SUPABASE_ANON_KEY=ganti-dengan-anon-key
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key
SUPABASE_JWT_SECRET=ganti-dengan-jwt-secret

# OpenWA berjalan di mesin yang sama. API key = nilai flag -k saat menjalankan OpenWA.
# WEBHOOK_SECRET minimal 16 karakter; buat acak, misal: openssl rand -hex 24
OPENWA_URL=http://localhost:8002
OPENWA_API_KEY=ganti-dengan-api-key-openwa
WEBHOOK_SECRET=ganti-dengan-rahasia-acak-minimal-16-karakter

# LLM dimatikan secara default (claude/LOCAL-MODE.md). Satu-satunya nilai valid: disabled
LLM_PROVIDER=disabled
LLM_API_KEY=

# Hanya untuk test integrasi (docker compose up -d postgres-test). Boleh dikosongkan dengan
# menghapus barisnya; test integrasi lalu dilewati. Jangan arahkan ke database Supabase:
# test menghapus isi tabel.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/postgres
